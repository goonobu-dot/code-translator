#!/bin/bash
# コード通訳: 翻訳の生成〜画面の表示までを1コマンドで行う。
#   code-translate <対象フォルダ> --open   … 翻訳して、ブラウザで画面を開く(人間用)
#   code-translate <対象フォルダ>          … 翻訳の更新のみ(フック・自動更新用)
# --open 時は対象フォルダに「コード通訳を開く.command」(ダブルクリックで開くボタン)も設置する。
set -euo pipefail
SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
TARGET="${1:?対象フォルダを指定してください (例: code-translate ~/my-app --open)}"
shift || true
TARGET="$(cd "$TARGET" && pwd)"
PORT=8931
OPEN=0
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --open) OPEN=1 ;;
    --port) PORT="$2"; shift ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done

if [ -f "$TARGET/.code-translate/paused" ]; then
  echo "コード通訳は一時停止中です($TARGET/.code-translate/paused を削除で再開)"
  exit 0
fi

VIEW="$TARGET/.code-translate/view"
python3 "$ROOT/analyzer/analyze.py" "$TARGET" ${ARGS[@]+"${ARGS[@]}"}
mkdir -p "$VIEW"
cp "$ROOT/generator/view-app.html" "$VIEW/index.html"

if [ "$OPEN" = 1 ]; then
  # 既存サーバーが「このプロジェクト」を配信しているか確認し、違えば空きポートを使う(取り違え防止)
  FOUND=""
  for P in $(seq "$PORT" $((PORT + 9))); do
    if ! nc -z 127.0.0.1 "$P" 2>/dev/null; then
      nohup python3 "$ROOT/generator/serve.py" "$VIEW" "$P" >/dev/null 2>&1 &
      sleep 0.5
      FOUND="$P"
      break
    fi
    T="$(curl -sf --max-time 2 "http://127.0.0.1:$P/view-data.json" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("target",""))' 2>/dev/null || true)"
    if [ "$T" = "$TARGET" ]; then
      FOUND="$P"
      break
    fi
  done
  if [ -z "$FOUND" ]; then
    echo "エラー: 使えるポートが見つかりません($PORT〜$((PORT + 9))が全て他の用途で使用中)" >&2
    exit 1
  fi
  PORT="$FOUND"
  # ダブルクリックで開ける「ボタン」を対象フォルダに設置(初回のみ)
  BTN="$TARGET/コード通訳を開く.command"
  if [ ! -f "$BTN" ]; then
    printf '#!/bin/bash\n"%s" "%s" --open\n' "$SELF" "$TARGET" > "$BTN"
    chmod +x "$BTN"
    echo "設置: $BTN (次からはこれをダブルクリックするだけで開けます)"
  fi
  open "http://localhost:$PORT"
  echo "画面: http://localhost:$PORT"
else
  echo "ビュー更新: $VIEW/index.html"
fi
