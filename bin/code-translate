#!/bin/bash
# コード通訳: 翻訳を作り、読む画面(1枚もののHTML)を用意する。
#
#   code-translate <対象フォルダ>            … 翻訳して artifact.html を作る(既定)
#   code-translate <対象フォルダ> --serve    … さらにローカル配信もする(URLを表示するだけ)
#   code-translate <対象フォルダ> --browser  … 外部ブラウザで開く(明示したときだけ)
#
# 既定ではブラウザを開かない。Claude Code内のページで読む運用のため。
set -euo pipefail
SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
TARGET="${1:?対象フォルダを指定してください (例: code-translate ~/my-app)}"
shift || true
TARGET="$(cd "$TARGET" && pwd)"
PORT=8931
SERVE=0
BROWSER=0
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --serve) SERVE=1 ;;
    --browser) SERVE=1; BROWSER=1 ;;
    --open) SERVE=1 ;;   # 旧称。ブラウザは開かない(明示するには --browser)
    --port) PORT="$2"; shift ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done

if [ -f "$TARGET/.code-translate/paused" ]; then
  echo "コード通訳は一時停止中です($TARGET/.code-translate/paused を削除で再開)"
  exit 0
fi

VIEW="$TARGET/.code-translate/view"
python3 "$ROOT/analyzer/analyze.py" "$TARGET" ${ARGS[@]+"${ARGS[@]}"}
mkdir -p "$VIEW"
cp "$ROOT/generator/view-app.html" "$VIEW/index.html"

# 読む画面(1枚で完結するHTML)を作る
python3 "$ROOT/generator/build_artifact.py" "$TARGET" >/dev/null
ART="$TARGET/.code-translate/artifact.html"
echo ""
echo "読む画面ができました:"
echo "  $ART"
echo ""
echo "開き方(どれでも同じ画面です):"
echo "  ・Finderでダブルクリック          open \"$ART\""
echo "  ・Claude Codeを使っている場合      チャットで「コードを見せて」と言うとページのリンクが渡されます"
echo "  ・ブラウザで開いてほしい場合        code-translate <対象> --browser"
echo ""

if [ "$SERVE" = 1 ]; then
  # 既存サーバーが「このプロジェクト」を配信しているか確認し、違えば空きポートを使う(取り違え防止)
  FOUND=""
  for P in $(seq "$PORT" $((PORT + 9))); do
    if ! nc -z 127.0.0.1 "$P" 2>/dev/null; then
      nohup python3 "$ROOT/generator/serve.py" "$VIEW" "$P" >/dev/null 2>&1 &
      sleep 0.5
      FOUND="$P"
      break
    fi
    T="$(curl -sf --max-time 2 "http://127.0.0.1:$P/view-data.json" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("target",""))' 2>/dev/null || true)"
    if [ "$T" = "$TARGET" ]; then
      FOUND="$P"
      break
    fi
  done
  if [ -z "$FOUND" ]; then
    echo "エラー: 使えるポートが見つかりません($PORT〜$((PORT + 9))が全て他の用途で使用中)" >&2
    exit 1
  fi
  PORT="$FOUND"
  echo "配信中: http://localhost:$PORT"
  # ブラウザを開くのは、明示的に頼まれたときだけ
  [ "$BROWSER" = 1 ] && open "http://localhost:$PORT"
fi
